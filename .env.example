# PRIVATE_KEY is stored in Moccasin's encrypted keystore — do NOT put it here.
# Import your key once with:
#   mox wallet import deployer
# Moccasin will prompt for a master password and encrypt the key at rest.

# ── Filled in after running: just setup ──────────────────────────────────────
TOKEN_ADDRESS=
VAULT_ADDRESS=

# ── Filled in after running: just create-agreement ───────────────────────────
AGREEMENT_ADDRESS=

# ── The asset recovery address (receives returned funds after an attack) ──────
# Set to your wallet address
RECOVERY_ADDRESS=

# ── BattleChain protocol addresses (pre-filled) ───────────────────────────────
ATTACK_REGISTRY=0x9E62988ccA776ff6613Fa68D34c9AB5431Ce57e1
